{
  "name": "openclawworld",
  "version": "1.0.0",
  "description": "OpenClawWorld is a multiplayer 3D world where humans and AI agents can walk around, chat, emote, and interact in real time.",
  "type": "module",
  "main": "claude-bot.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "bot:claude": "node claude-bot.js",
    "bot:codex": "node codex-bot.js",
    "bot:auto": "node bot-supervisor.js",
    "bot:auto:once": "node bot-supervisor.js --once --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevvGwardo/openclawworld.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DevvGwardo/openclawworld/issues"
  },
  "homepage": "https://github.com/DevvGwardo/openclawworld#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "socket.io-client": "^4.8.3"
  }
}
